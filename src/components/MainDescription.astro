---
import Container from "./Container.astro";
import LogoWall from "./LogoWall.astro";
---

<div class="relative" id="home">
  <div
    aria-hidden="true"
    class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-20"
  >
    <div
      class="blur-[106px] h-56 bg-gradient-to-br from-primary to-purple-400 dark:from-blue-700"
    >
    </div>
    <div
      class="blur-[106px] h-32 bg-gradient-to-r from-cyan-400 to-sky-300 dark:to-indigo-600"
    >
    </div>
  </div>
  <Container>
    <div class="relative pt-36 ml-auto">
      <div class="lg:w-2/3 text-center mx-auto">
        <h1
          class="text-gray-900 text-balance dark:text-white font-bold text-5xl md:text-6xl xl:text-7xl pt-9"
        >
          Transforma Tu
          <span
            id="dynamic-text"
            class="text-primary dark:text-white block min-h-[1.2em]"></span>
        </h1>

        <p
          class="mt-8 mb-13 text-gray-700 dark:text-gray-300 font-[Montserrat]"
        >
          En Astralyss, impulsamos el crecimiento de tu marca o negocio con
          innovación, calidad y tecnología de vanguardia. Nos enfocamos en cada
          detalle para ofrecerte soluciones de alto impacto que marquen la
          diferencia.
        </p>

        <LogoWall />
      </div>
    </div>
  </Container>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const phrases = ["Empresa", "Marca", "Negocio", "Proyecto"];
    let i = 0;
    const textElement = document.getElementById("dynamic-text");

    function typeEffect(text, index = 0) {
      if (index < text.length) {
        textElement.textContent += text[index];
        setTimeout(() => typeEffect(text, index + 1), 100); // Velocidad de escritura
      } else {
        setTimeout(eraseEffect, 1000); // Espera antes de borrar
      }
    }

    function eraseEffect() {
      if (textElement.textContent.length > 0) {
        textElement.textContent = textElement.textContent.slice(0, -1);
        setTimeout(eraseEffect, 50); // Velocidad de borrado
      } else {
        i = (i + 1) % phrases.length; // Cambia de frase
        setTimeout(() => typeEffect(phrases[i]), 500);
      }
    }

    typeEffect(phrases[i]); // Inicia la animación
  });
</script>
